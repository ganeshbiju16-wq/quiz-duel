# Copy to .env and fill in (never upload .env to GitHub)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quizgame
PORT=3000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Your frontend's URL (use * only while testing)
CLIENT_ORIGIN=*

# true = test login by typing a name (turn off once Google sign-in is added)
DEV_AUTH=true
